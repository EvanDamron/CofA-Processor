import SwiftUI
import PDFKit

struct AccuracyCheckerViewExternal: View {
    let pdfURL: URL
    let initialJSON: [String: Any]

    @State private var jsonData: [(key: String, value: Any)] = []
    @State private var textFields: [String: String] = [:]
    @State private var submissionSuccess = false
    @State private var errorMessage: String?
    @State private var selectedTab = 0

    var body: some View {
        TabView(selection: $selectedTab) {
            // 1. Editing Tab
            ScrollView {
                VStack(alignment: .leading, spacing: 15) {
                    if let errorMessage = errorMessage {
                        Text("Error: \(errorMessage)")
                            .foregroundColor(.red)
                    }

                    ForEach(jsonData, id: \.key) { item in
                        EditableFieldGroup(
                            key: item.key,
                            value: item.value,
                            textFields: $textFields
                        )
                    }

                    Button("Approve & Submit") {
                        submitJSON()
                    }
                    .padding()
                    .background(Color.green)
                    .foregroundColor(.white)
                    .cornerRadius(10)

                    if submissionSuccess {
                        Text("✅ Submitted successfully!")
                            .foregroundColor(.green)
                    }
                }
                .padding()
            }
            .tag(0)
            .tabItem {
                Label("Edit Fields", systemImage: "square.and.pencil")
            }

            // 2. PDF Viewer Tab
            PDFViewWrapper(url: pdfURL)
                .tag(1)
                .tabItem {
                    Label("View PDF", systemImage: "doc.richtext")
                }
        }
        .navigationTitle("Accuracy Checker")
        .onAppear {
            loadInitialJSON()
        }
    }

    private func loadInitialJSON() {
        jsonData = initialJSON.sorted { $0.key < $1.key }
        for (key, value) in initialJSON {
            if let array = value as? [Any] {
                for i in array.indices {
                    textFields["\(key)_\(i)"] = String(describing: array[i])
                }
            } else {
                textFields[key] = String(describing: value)
            }
        }
    }

    private func submitJSON() {
        var updatedJSON: [String: Any] = [:]

        for (key, value) in jsonData {
            if let array = value as? [Any] {
                updatedJSON[key] = array.indices.map {
                    textFields["\(key)_\($0)"] ?? ""
                }
            } else {
                updatedJSON[key] = textFields[key] ?? ""
            }
        }

        guard let url = URL(string: "http://34.194.202.42:5000/verify"),
              let data = try? JSONSerialization.data(withJSONObject: updatedJSON) else {
            errorMessage = "Failed to encode JSON"
            return
        }

        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        request.httpBody = data

        URLSession.shared.dataTask(with: request) { _, _, error in
            DispatchQueue.main.async {
                if let error = error {
                    errorMessage = error.localizedDescription
                } else {
                    submissionSuccess = true
                    errorMessage = nil
                }
            }
        }.resume()
    }
}

// MARK: - EditableFieldGroup Subview
struct EditableFieldGroup: View {
    let key: String
    let value: Any
    @Binding var textFields: [String: String]

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            Text(key.capitalized)
                .font(.headline)

            if let array = value as? [Any] {
                ForEach(array.indices, id: \.self) { i in
                    let fieldKey = "\(key)_\(i)"
                    TextField("\(key) \(i + 1)", text: Binding(
                        get: { textFields[fieldKey, default: ""] },
                        set: { textFields[fieldKey] = $0 }
                    ))
                    .textFieldStyle(RoundedBorderTextFieldStyle())
                    .keyboardType(.default)
                }
            } else {
                TextField(key, text: Binding(
                    get: { textFields[key, default: ""] },
                    set: { textFields[key] = $0 }
                ))
                .textFieldStyle(RoundedBorderTextFieldStyle())
                .keyboardType(.default)
            }
        }
    }
}

// MARK: - PDFViewWrapper (No Focus Hijacking)
struct PDFViewWrapper: UIViewRepresentable {
    let url: URL

    func makeUIView(context: Context) -> PDFView {
        let pdfView = PDFView()
        if let doc = PDFDocument(url: url) {
            pdfView.document = doc
        }
        pdfView.autoScales = true
        pdfView.displayMode = .singlePageContinuous
        pdfView.displayDirection = .vertical

        return pdfView
    }

    func updateUIView(_ uiView: PDFView, context: Context) {}
}
